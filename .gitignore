# Model checkpoints (4 GB)
model_chkpt/
# Allow specific tier-A V6+TierA IEMOCAP checkpoint+Shapley bundle (78 MB)
!model_chkpt/
!model_chkpt/IEMOCAP/
!model_chkpt/IEMOCAP/multimodal_model/
!model_chkpt/IEMOCAP/multimodal_model/2026-05-23_IEMOCAP_v6_iemocap/
!model_chkpt/IEMOCAP/multimodal_model/2026-05-23_IEMOCAP_v6_iemocap/**

# Training / eval logs
logs/

# TensorBoard event files
runs/

# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd

# Large data products
*.npz
*.pth
*.pt
*.h5
*.hdf5
# Re-allow files inside the whitelisted tierA bundle
!model_chkpt/IEMOCAP/multimodal_model/2026-05-23_IEMOCAP_v6_iemocap/*.npz
!model_chkpt/IEMOCAP/multimodal_model/2026-05-23_IEMOCAP_v6_iemocap/*.pth

# OS artifacts
.DS_Store
Thumbs.db
